generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  USER
}

enum Provider {
  LOCAL
  GOOGLE
  FACEBOOK
  GITHUB
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  googleId     String?   @unique
  facebookId   String?   @unique
  password     String?
  name         String
  phone        String?
  role         Role      @default(USER)
  avatar       String?
  provider     Provider  @default(LOCAL)
  isVerified   Boolean   @default(false)
  isBlocked    Boolean   @default(false)
  lastLoginAt  DateTime?
  refreshToken String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // relations (back-references needed by other models below)
  store              Store?
  addresses          Address[]
  cart               Cart?
  wishlists          Wishlist[]
  orders             Order[]
  complaints         Complaint[]
  ownerConversations Conversation[]      @relation("OwnerConversation")
  userConversations  Conversation[]      @relation("UserConversation")
  messages           Message[]           @relation("UserMessages")
  notifications      Notification[]
  reviews            Review[]
  commissionSettings CommissionSetting[] @relation("CommissionUpdatedBy")
  couponsCreated     Coupon[]            @relation("CouponCreatedBy")
  inventoryLogs      InventoryLog[]      @relation("InventoryLogCreatedBy")
  auditLogs          AuditLog[]
  sessions           Session[]
  followedStores     StoreFollower[]
  searchHistories    SearchHistory[]
  recentlyViewed     RecentlyViewed[]
}

model Store {
  id              String          @id @default(cuid())
  ownerId         String          @unique
  name            String
  slug            String          @unique
  logo            String?
  banner          String?
  coverImage      String?
  description     String?
  phone           String?
  email           String?
  address         String?
  latitude        Float?
  longitude       Float?
  taxCode         String?
  businessLicense String?
  openingHours    String?
  isVerified      Boolean         @default(false)
  status          StoreStatus     @default(PENDING)
  rating          Float           @default(0)
  totalSold       Int             @default(0)
  paymentSetting  PaymentSetting?
  products        Product[]
  categories      Category[]
  coupons         Coupon[]
  analyticsDaily  AnalyticsDaily[]
  analyticsMonthly AnalyticsMonthly[]
  followers       StoreFollower[]
  visitors        Visitor[]
  owner           User               @relation(fields: [ownerId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([ownerId])
}

model Category {
  id       String     @id @default(cuid())
  storeId  String
  store    Store      @relation(fields: [storeId], references: [id])
  name     String
  slug     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
  @@unique([storeId, name])
  @@index([storeId])
}

model Product {
  id              String              @id @default(cuid())
  storeId         String
  categoryId      String
  name            String
  slug            String
  description     String
  basePrice       Decimal?
  discount        Decimal?
  thumbnail       String?
  video           String?
  brand           String?
  sku             String?
  status          ProductStatus
  weightUnit      String?
  dimensionUnit   String?
  seoTitle        String?
  seoDescription  String?
  isFeatured      Boolean             @default(false)
  sold            Int                 @default(0)
  viewCount       Int                 @default(0)
  rating          Float               @default(0)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  category        Category            @relation(fields: [categoryId], references: [id])
  store           Store               @relation(fields: [storeId], references: [id])
  colors          ProductColor[]      @relation("ProductColor")
  images          ProductImage[]      @relation("ProductImage")
  reviews         Review[]
  wishlists       Wishlist[]
  statistic       ProductStatistic?
  recentlyViewed  RecentlyViewed[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([deletedAt])
}

model ProductColor {
  id        String           @id @default(cuid())
  productId String
  name      String
  image     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation("ProductColor", fields: [productId], references: [id])
  variants  ProductVariant[] @relation("ProductColor")

  @@unique([productId, name])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productColorId String
  size           String
  isDefault      Boolean        @default(false)
  image          String?
  weight         Decimal?
  length         Decimal?
  width          Decimal?
  height         Decimal?
  stock          Int
  price          Decimal
  costPrice      Decimal?
  sku            String?
  barcode        String?
  cartItems      CartItem[]
  inventoryLogs  InventoryLog[]
  orderItems     OrderItem[]
  productColor   ProductColor   @relation("ProductColor", fields: [productColorId], references: [id])

  @@unique([productColorId, size])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  image     String
  sortOrder Int     @default(0)
  product   Product @relation("ProductImage", fields: [productId], references: [id])
}

model ProductStatistic {
  id        String  @id @default(cuid())
  productId String  @unique
  views     Int     @default(0)
  sold      Int     @default(0)
  wishlist  Int     @default(0)
  rating    Float   @default(0)
  product   Product @relation(fields: [productId], references: [id])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  receiver  String
  phone     String
  province  String
  district  String
  ward      String
  detail    String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id])
  orders    Order[]

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  productVariantId String
  quantity         Int
  cart             Cart           @relation(fields: [cartId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Wishlist {
  id        String  @id @default(cuid())
  userId    String
  productId String
  product   Product @relation(fields: [productId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  addressId       String?
  couponId        String?
  subtotal        Decimal
  discount        Decimal
  shippingFee     Decimal
  commission      Decimal
  total           Decimal
  ownerReceive    Decimal
  platformReceive Decimal
  status          OrderStatus
  paymentMethod   PaymentMethod
  note            String?
  paidAt          DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  complaint       Complaint?    @relation("OrderComplaint")
  user            User          @relation(fields: [userId], references: [id])
  address         Address?      @relation(fields: [addressId], references: [id])
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  payment         Payment?
  refund          Refund?
  shipment        Shipment?

  @@index([userId])
  @@index([status])
  @@index([addressId])
  @@index([couponId])
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  productVariantId String
  productName      String
  productImage     String?
  variantName      String?
  quantity         Int
  price            Decimal
  order            Order          @relation(fields: [orderId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String          @unique
  provider      PaymentProvider
  transactionId String?
  amount        Decimal
  qrCode        String?
  status        PaymentStatus
  paidAt        DateTime?
  callbackData  Json?
  failureReason String?
  order         Order           @relation(fields: [orderId], references: [id])
}

model PaymentSetting {
  id              String   @id @default(cuid())
  storeId         String   @unique
  momoPartnerCode String?
  momoAccessKey   String?
  momoSecretKey   String?
  momoEnvironment String?
  vnpayTmnCode    String?
  vnpayHashSecret String?
  stripeSecretKey String?
  isMomoEnabled   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id])
}

model Refund {
  id      String       @id @default(cuid())
  orderId String       @unique
  amount  Decimal
  reason  String
  status  RefundStatus
  order   Order        @relation(fields: [orderId], references: [id])
}

model Complaint {
  id          String                @id @default(cuid())
  orderId     String                @unique
  userId      String
  ownerReply  String?
  adminReply  String?
  title       String
  description String
  status      ComplaintStatus
  order       Order                 @relation("OrderComplaint", fields: [orderId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])
  attachments ComplaintAttachment[]
}

model ComplaintAttachment {
  id          String    @id @default(cuid())
  complaintId String
  url         String
  type        String
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  @@index([complaintId])
}

model Shipment {
  id                String            @id @default(cuid())
  orderId           String            @unique
  driverName        String?
  driverPhone       String?
  trackingNumber    String?
  carrier           String?
  latitude          Float?
  longitude         Float?
  estimatedTime     String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  status            ShipmentStatus
  order             Order             @relation(fields: [orderId], references: [id])
  histories         ShipmentHistory[]
}

model Conversation {
  id       String    @id @default(cuid())
  userId   String
  ownerId  String
  owner    User      @relation("OwnerConversation", fields: [ownerId], references: [id])
  user     User      @relation("UserConversation", fields: [userId], references: [id])
  messages Message[]

  @@unique([userId, ownerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           MessageType
  fileUrl        String?
  seen           Boolean      @default(false)
  editedAt       DateTime?
  replyToId      String?
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id])
  replies        Message[]    @relation("MessageReply")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("UserMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  content   String
  image     String?
  type      NotificationType
  link      String?
  action    String?
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
}

model Coupon {
  id              String     @id @default(cuid())
  storeId         String
  store           Store      @relation(fields: [storeId], references: [id])
  code            String
  description     String?
  discount        Decimal
  minimumOrder    Decimal
  maximumDiscount Decimal?
  maxUsagePerUser Int?
  quantity        Int
  startAt         DateTime
  expiredAt       DateTime
  isActive        Boolean    @default(true)
  usedCount       Int        @default(0)
  type            CouponType
  createdBy       String
  createdByUser   User       @relation("CouponCreatedBy", fields: [createdBy], references: [id])
  orders          Order[]

  @@unique([storeId, code])
  @@index([storeId])
}

model CommissionSetting {
  id             String   @id @default(cuid())
  commissionRate Decimal
  updatedBy      String
  updatedByUser  User     @relation("CommissionUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt      DateTime @updatedAt

  @@index([updatedBy])
}

model AnalyticsDaily {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  date            DateTime
  revenue         Decimal
  profit          Decimal
  orders          Int
  cancelled       Int      @default(0)
  refund          Decimal  @default(0)
  visitors        Int
  newCustomer     Int      @default(0)
  conversionRate  Float    @default(0)

  @@unique([storeId, date])
  @@index([storeId])
}

model AnalyticsMonthly {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  month           DateTime
  revenue         Decimal
  profit          Decimal
  orders          Int
  cancelled       Int      @default(0)
  refund          Decimal  @default(0)
  visitors        Int
  newCustomer     Int      @default(0)
  conversionRate  Float    @default(0)

  @@unique([storeId, month])
  @@index([storeId])
}

model InventoryLog {
  id               String         @id @default(cuid())
  productVariantId String
  quantity         Int
  beforeStock      Int
  afterStock       Int
  type             InventoryType
  note             String?
  createdBy        String?
  createdByUser    User?          @relation("InventoryLogCreatedBy", fields: [createdBy], references: [id])
  createdAt        DateTime       @default(now())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([productVariantId])
  @@index([createdBy])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  images    String[]
  videos    String[]
  reply     String?
  replyAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
}

model ShipmentHistory {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  latitude    Float?
  longitude   Float?
  description String?
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id])
}

model Visitor {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  ip        String?
  country   String?
  device    String?
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  image     String
  link      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpLog {
  id        String   @id @default(cuid())
  email     String
  type      String
  expiredAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  device       String?
  browser      String?
  ip           String?
  refreshToken String
  expiredAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model StoreFollower {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  store     Store    @relation(fields: [storeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([storeId, userId])
  @@index([storeId])
  @@index([userId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  keyword   String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

enum CouponType {
  PERCENT
  FIXED
}

enum NotificationType {
  ORDER
  CHAT
  PAYMENT
  REFUND
  COMPLAINT
  REVIEW
  SHIPMENT
}

enum InventoryType {
  INCREASE
  DECREASE
  RETURN
}

enum StoreStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  MOMO
  VNPAY
  STRIPE
}

enum PaymentProvider {
  MOMO
  VNPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ComplaintStatus {
  PENDING
  OWNER_RESPONDED
  ESCALATED
  RESOLVED
  CLOSED
}

enum ShipmentStatus {
  PREPARING
  PICKED_UP
  SHIPPING
  DELIVERED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  EMOJI
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  USER
}

enum Provider {
  LOCAL
  GOOGLE
  FACEBOOK
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  role          Role      @default(USER)
  avatar        String?
  id             String          @id @default(cuid())
  ownerId        String          @unique
  name           String
  slug           String          @unique
  logo           String?
  banner         String?
  description    String?
  phone          String?
  email          String?
  address        String?
  latitude       Float?
  longitude      Float?
  status         StoreStatus     @default(PENDING)
  rating         Float           @default(0)
  totalSold      Int             @default(0)
  paymentSetting PaymentSetting?
  products       Product[]
  owner          User            @relation(fields: [ownerId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  ownerId  String
  owner    User       @relation(fields: [ownerId], references: [id])
}

model Product {
  id          String         @id @default(cuid())
  storeId     String
  categoryId  String
  name        String
  slug        String         @unique
  description String
  basePrice   Decimal?
  discount    Decimal?
  thumbnail   String
  brand       String?
  sku         String?
  status      ProductStatus
  sold        Int            @default(0)
  viewCount   Int            @default(0)
  rating      Float          @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  category    Category       @relation(fields: [categoryId], references: [id])
  store       Store          @relation(fields: [storeId], references: [id])
  colors      ProductColor[] @relation("ProductColor")
  images      ProductImage[] @relation("ProductImage")
  reviews     Review[]
  wishlists   Wishlist[]
}

model ProductColor {
  id        String           @id @default(cuid())
  productId String
  name      String
  image     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation("ProductColor", fields: [productId], references: [id])
  variants  ProductVariant[] @relation("ProductColor")

  @@unique([productId, name])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productColorId String
  size           String
  weight         Decimal?
  length         Decimal?
  width          Decimal?
  height         Decimal?
  stock          Int
  price          Decimal
  sku            String?
  barcode        String?
  cartItems      CartItem[]
  inventoryLogs  InventoryLog[]
  orderItems     OrderItem[]
  productColor   ProductColor   @relation("ProductColor", fields: [productColorId], references: [id])

  @@unique([productColorId, size])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  image     String
  sortOrder Int     @default(0)
  product   Product @relation("ProductImage", fields: [productId], references: [id])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  receiver  String
  phone     String
  province  String
  district  String
  ward      String
  detail    String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id])
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  productVariantId String
  quantity         Int
  cart             Cart           @relation(fields: [cartId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Wishlist {
  id        String  @id @default(cuid())
  userId    String
  productId String
  product   Product @relation(fields: [productId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  subtotal        Decimal
  discount        Decimal
  shippingFee     Decimal
  commission      Decimal
  total           Decimal
  ownerReceive    Decimal
  platformReceive Decimal
  status          OrderStatus
  paymentMethod   PaymentMethod
  createdAt       DateTime      @default(now())
  complaint       Complaint?    @relation("OrderComplaint")
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payment         Payment?
  refund          Refund?
  shipment        Shipment?
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  productVariantId String
  quantity         Int
  price            Decimal
  order            Order          @relation(fields: [orderId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String          @unique
  provider      PaymentProvider
  transactionId String?
  amount        Decimal
  qrCode        String?
  status        PaymentStatus
  order         Order           @relation(fields: [orderId], references: [id])
}

model PaymentSetting {
  id              String   @id @default(cuid())
  storeId         String   @unique
  momoPartnerCode String?
  momoAccessKey   String?
  momoSecretKey   String?
  momoEnvironment String?
  vnpayTmnCode    String?
  vnpayHashSecret String?
  stripeSecretKey String?
  paypalClientId  String?
  paypalSecretKey String?
  isMomoEnabled   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id])
}

model Refund {
  id      String       @id @default(cuid())
  orderId String       @unique
  amount  Decimal
  reason  String
  status  RefundStatus
  order   Order        @relation(fields: [orderId], references: [id])
}

model Complaint {
  id          String          @id @default(cuid())
  orderId     String          @unique
  userId      String
  ownerReply  String?
  adminReply  String?
  title       String
  description String
  status      ComplaintStatus
  order       Order           @relation("OrderComplaint", fields: [orderId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
}

model Shipment {
  id            String            @id @default(cuid())
  orderId       String            @unique
  driverName    String?
  driverPhone   String?
  latitude      Float?
  longitude     Float?
  estimatedTime String?
  status        ShipmentStatus
  order         Order             @relation(fields: [orderId], references: [id])
  histories     ShipmentHistory[]
}

model Conversation {
  id       String    @id @default(cuid())
  userId   String
  ownerId  String
  owner    User      @relation("OwnerConversation", fields: [ownerId], references: [id])
  user     User      @relation("UserConversation", fields: [userId], references: [id])
  messages Message[]

  @@unique([userId, ownerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           MessageType
  seen           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("UserMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  content   String
  type      NotificationType
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  discount        Decimal
  minimumOrder    Decimal
  maximumDiscount Decimal?
  quantity        Int
  startAt         DateTime
  expiredAt       DateTime
  isActive        Boolean    @default(true)
  usedCount       Int        @default(0)
  type            CouponType
}

model CommissionSetting {
  id             String   @id @default(cuid())
  commissionRate Decimal
  updatedAt      DateTime @updatedAt
}

model AnalyticsDaily {
  id       String   @id @default(cuid())
  date     DateTime
  revenue  Decimal
  orders   Int
  visitors Int
}

model AnalyticsMonthly {
  id       String   @id @default(cuid())
  month    DateTime
  revenue  Decimal
  orders   Int
  visitors Int
}

model InventoryLog {
  id               String         @id @default(cuid())
  productVariantId String
  quantity         Int
  type             InventoryType
  note             String?
  createdAt        DateTime       @default(now())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model ShipmentHistory {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  latitude    Float?
  longitude   Float?
  description String?
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id])
}

enum CouponType {
  PERCENT
  FIXED
}

enum NotificationType {
  ORDER
  CHAT
  PAYMENT
  REFUND
}

enum InventoryType {
  INCREASE
  DECREASE
  RETURN
}

enum StoreStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
}

enum StoreStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  MOMO
  VNPAY
  STRIPE
}

enum PaymentProvider {
  MOMO
  VNPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ComplaintStatus {
  PENDING
  OWNER_RESPONDED
  ESCALATED
  RESOLVED
  CLOSED
}

enum ShipmentStatus {
  PREPARING
  PICKED_UP
  SHIPPING
  DELIVERED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}
